# Copy to .env and fill in. Never commit .env.

# App
# Full URL of the app, e.g. http://localhost:3000. Locally its port is also the dev server port.
CODEFAIR_APP_DOMAIN=
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=
# Base URL of the validator service
VALIDATOR_URL=

# GitHub App
GH_APP_ID=
GH_APP_NAME=
# PEM contents on one line, with newlines written as \n
GH_APP_PRIVATE_KEY=
WEBHOOK_SECRET=
# Local only: smee.io channel that forwards GitHub webhooks to the dev server
WEBHOOK_PROXY_URL=

# GitHub OAuth App (sign-in)
GH_OAUTH_APP_ID=
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=

# Zenodo (use sandbox.zenodo.org locally)
# e.g. https://sandbox.zenodo.org
ZENODO_ENDPOINT=
# e.g. https://sandbox.zenodo.org/api
ZENODO_API_ENDPOINT=
ZENODO_CLIENT_ID=
ZENODO_CLIENT_SECRET=
# e.g. http://localhost:3000/api/zenodo/callback
ZENODO_REDIRECT_URI=
# Optional: parallel file uploads per release (default 3)
ZENODO_UPLOAD_CONCURRENCY=

# Encrypts stored GitHub and Zenodo tokens. Use a different key per environment.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Logging
UI_LOGWATCH_URL=
